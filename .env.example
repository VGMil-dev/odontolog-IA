# ==============================================================================
# ODONTOCARE IA — VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# Copia este archivo a .env y configura tus propias claves
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

ACTIVE_PROVIDER=telegram

CLINIC_NAME="Clínica OdontoCare"
CLINIC_CITY="Cuenca"
CLINIC_COUNTRY="Ecuador"
CLINIC_EMERGENCY_PHONE="+593 98 000 0000"

# IA & Modelos
VERCEL_AI_GATEWAY_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
PRIMARY_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=google/gemini-2.5-flash

# Transcripción de Audio
ASSEMBLYAI_API_KEY=

# Telegram Bot (Testing Seguro)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# WhatsApp Meta Cloud API (Producción)
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=odonto_care_secure_token_2026

# Redis (Buffer y Bloqueos)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
DEBOUNCE_DELAY_MS=5000

# Chatwoot CRM (Human Handoff)
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Cifrado de Sesiones Clínicas (AES-256-GCM)
SESSION_ENCRYPTION_KEY=odonto_care_secure_vault_aes256_key_2026
