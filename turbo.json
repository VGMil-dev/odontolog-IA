{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!/.next/cache/**"]
    },
    "start": {
      "dependsOn": ["build"],
      "inputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "tests/**"],
      "outputs": []
    },
    "lint": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "typecheck": {
      "dependsOn": [],
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "dependsOn": [],
      "outputs": ["apps/api/node_modules/.prisma/client/**"]
    }
  }
}