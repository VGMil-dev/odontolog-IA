{
  "name": "odontolog-ia",
  "version": "2.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate",
    "db:push": "pnpm --filter api exec prisma db push",
    "db:studio": "pnpm --filter api exec prisma studio",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "clean": "rimraf dist .next node_modules .turbo"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "prisma": "^6",
    "rimraf": "^6",
    "turbo": "^2.3.0",
    "typescript": "^5.7"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "@google/genai",
      "protobufjs"
    ]
  }
}